# KG (Kyrgyz) is the default language - redirect /kg URLs to clean URLs
/kg  /  301
/kg/  /  301
/kg/:splat  /:splat  301

# EN and RU - serve the right file but keep the language prefix in the URL
/en  /index.html  200
/ru  /index.html  200
/en/  /index.html  200
/ru/  /index.html  200
/en/*  /:splat  200
/ru/*  /:splat  200
